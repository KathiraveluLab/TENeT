# Environment Configuration for TENeT

# API Configuration
# URL for the TENeT backend API (without /api suffix - will be added by api.js)
# Default for local development: http://localhost:8000/api
# Production: Set to your deployed backend URL (e.g., https://api.tenet.example.com/api)
VITE_API_URL=http://localhost:8000/api

# Map Configuration
VITE_DEFAULT_ZOOM=4
VITE_ALASKA_LAT=64.0685
VITE_ALASKA_LNG=-152.2782

# Development settings
VITE_NODE_ENV=development
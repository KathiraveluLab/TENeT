# TENeT Development Environment
# Copy this file to .env and adjust as needed
#   cp .env.example .env

# Ports (change if defaults conflict with other services)
BACKEND_PORT=5001
FRONTEND_PORT=5173

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=1

# Database (sqlite is default, no extra config needed)
DB_TYPE=sqlite
DB_PATH=/app/data/tenet.db

# Frontend API base URL baked into the React build.
# /api/cat is proxied to the backend by nginx in Docker.
VITE_API_BASE_URL=/api/cat
